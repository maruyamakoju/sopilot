# SOPilot GPU Image — CUDA 12.1 + PyTorch 2.x for RTX 4090
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-dev python3.11-pip python3-pip \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1-mesa-glx \
    git curl wget \
    && rm -rf /var/lib/apt/lists/*

# Use python3.11 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/pip3 pip3 /usr/bin/pip3.11 1 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/pip3.11 /usr/bin/pip

WORKDIR /app

# Copy and install base dependencies
COPY pyproject.toml ./
COPY sopilot/__init__.py sopilot/

# Install PyTorch with CUDA 12.1
RUN pip install --no-cache-dir \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# Install ML inference stack
RUN pip install --no-cache-dir \
    ultralytics \
    transformers \
    timm \
    accelerate \
    "bitsandbytes>=0.41.0"

# Install application
COPY . .
RUN pip install --no-cache-dir -e ".[speed]"

# SAM 2 (optional — install if available)
RUN pip install --no-cache-dir "git+https://github.com/facebookresearch/segment-anything-2.git" 2>/dev/null || true

ENV PYTHONUNBUFFERED=1 \
    SOPILOT_DEVICE=cuda \
    SOPILOT_NEURAL_REID=true \
    SOPILOT_DETECTOR_BACKEND=cascade \
    SOPILOT_ORCHESTRATOR_ENABLED=true \
    SOPILOT_DINOV2_ENABLED=true \
    SOPILOT_TEMPORAL_FUSION_ENABLED=true \
    SOPILOT_ONLINE_LEARNING_ENABLED=true

EXPOSE 8000

CMD ["uvicorn", "sopilot.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
